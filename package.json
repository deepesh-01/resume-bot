{
  "name": "resume-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "init-workspace": "bash scripts/init-workspace.sh",
    "typecheck": "tsc -p . --noEmit",
    "docs:check": "bash scripts/docs-sync.sh check",
    "docs:sync": "bash scripts/docs-sync.sh apply",
    "render-base": "node dist/render-base.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
